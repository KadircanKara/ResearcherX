# LLM — Groq free tier via its OpenAI-compatible API.
# Get a free key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=llama-3.3-70b-versatile
# SDK retry budget — absorbs Groq free-tier 429s with exponential backoff.
LLM_MAX_RETRIES=5

# Optional daily-quota failover: when the active provider keeps 429ing after
# SDK retries (Groq free tier = 100k tokens/day ≈ 8 full runs), calls rotate
# to the next entry. JSON list, order = priority. Recommended first fallback:
# Gemini Flash (free key: https://aistudio.google.com/apikey — generous RPD).
# OpenRouter only as a LAST resort with a pinned :free model (50 req/day
# unverified ≈ 2-3 runs; never use the openrouter/free auto-router — it picks
# models that reject system messages / response_format).
# LLM_FALLBACKS='[{"base_url":"https://generativelanguage.googleapis.com/v1beta/openai/","api_key":"AIza...","model":"gemini-2.0-flash"},{"base_url":"https://openrouter.ai/api/v1","api_key":"sk-or-v1-...","model":"meta-llama/llama-3.3-70b-instruct:free"}]'

# Embeddings — Ollama (nomic-embed-text) on the compose network. No key, no
# quota. 768 dims, matching vector(768) in the schema.
# Prod overrides these via SSM: EMBEDDING_BASE_URL=https://api.openai.com/v1,
# EMBEDDING_MODEL=text-embedding-3-small, EMBEDDING_API_KEY=<openai key>,
# and BOTH prefixes empty (OpenAI does not use them).
EMBEDDING_BASE_URL=http://ollama:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
# nomic distinguishes documents from queries by prefix. No trailing space.
EMBEDDING_DOCUMENT_PREFIX=search_document:
EMBEDDING_QUERY_PREFIX=search_query:
# Cosine-distance retrieval cutoff — MODEL-SPECIFIC, re-measure per model.
# 0.75 was measured against nomic-embed-text in dev; not yet measured for
# OpenAI text-embedding-3-small (prod). See config.py for the measurements.
SIMILARITY_THRESHOLD=0.75
# Hard ceiling on excerpts sent to the chat model per turn. Bounds context by
# the CONTEXT WINDOW rather than by library size — without it a 100-paper
# project retrieved 191 chunks (~118.5k tokens) and every turn failed.
# Lower it if your provider caps a single request: Groq's free tier allows
# 12k tokens/minute, and at ~100 papers the per-turn PAPERS metadata block
# already spends ~5.5k of that, leaving room for roughly 5 excerpts.
MAX_CONTEXT_CHUNKS=60
# Output budget for one chat answer — PROVIDER-SPECIFIC, re-measure per model.
# Reasoning models bill thinking against max_tokens and the charge is invisible
# in completion_tokens: gemini-3.6-flash spent 1,921 of a 2,000 budget on
# thinking and 75 on the answer, truncating every reply mid-sentence. Thinking
# cannot be capped from the OpenAI-compatible endpoint. Lower this for a
# non-reasoning model on a tight per-request tier.
CHAT_ANSWER_MAX_TOKENS=6000

# Output budget for one query reformulation — PROVIDER-SPECIFIC. The output is
# a single short query string, but a reasoning model spends ~1,900 tokens
# thinking before emitting a character. max_tokens is a cap, not a charge.
QUERY_REFORMULATOR_MAX_TOKENS=3000

# Output budget for one paper-targeting call — PROVIDER-SPECIFIC. The output is
# a single paper id, but a reasoning model spends ~1,900 tokens thinking before
# emitting a character. max_tokens is a cap, not a charge.
PAPER_TARGETER_MAX_TOKENS=3000

DATABASE_URL=postgresql+asyncpg://researcherx:researcherx@db:5432/researcherx
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Long random string; X-API-Key with this value bypasses rate limits.
# Required when ENVIRONMENT=prod.
OWNER_API_KEY=
# ENVIRONMENT=prod   # uncomment on the production box (enables boot guards)